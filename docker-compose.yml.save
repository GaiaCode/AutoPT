version: "3.8"
services:
  juiceshop:
    image: bkimminich/juice-shop:latest
    environment:
      - NODE_ENV=unsafe
    ports:
      - "3000:3000"
  dvwa:
    image: vulnerables/web-dvwa
    ports:
      - "8080:80"
  agent:
    build: ./agent
    volumes:
      - ./agent/src:/app
    networks: 
      - default
    depends_on:
      - juiceshop
      - dvwa
    networks:
      default:
        driver: bridge
